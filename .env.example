# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Defaults ──────────────────────────────────────────────────────────────────
DEFAULT_AUTHOR=Dansticker

# ── Paths ─────────────────────────────────────────────────────────────────────
DB_PATH=data/dansticker.db
WORK_DIR=work
LOG_DIR=logs

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Concurrency ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_DOWNLOADS=3

# ── WhatsApp limits ───────────────────────────────────────────────────────────
MAX_STICKERS_PER_PACK=30

# ── Resource limits ───────────────────────────────────────────────────────────
MAX_SINGLE_STICKER_SIZE=10485760
MAX_DOWNLOAD_SIZE=209715200
MAX_VIDEO_DURATION=8
MAX_OUTPUT_SIZE=512000
MAX_JOB_RUNTIME=600
MAX_FFMPEG_TIMEOUT=120

# ── Media encoding ────────────────────────────────────────────────────────────
WEBP_QUALITY=80
WEBP_FPS=15

# ── FFmpeg (leave blank for system default) ───────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
